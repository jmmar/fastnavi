<!-- NX2NAVI runtime shader translator: Switch Maxwell code -> SPIR-V (Vulkan) via the vendored 1.3.2 shader translator.
     Copyright (c) 2026 jhaizhou (MIT; see THIRD_PARTY_NOTICES.md). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- tools/build_xlate.py passes the patched copy under build/xlate/ryujinx. -->
    <RyuSrc Condition="'$(RyuSrc)' == ''">$(MSBuildThisFileDirectory)../vendor/ryujinx</RyuSrc>
  </PropertyGroup>
  <ItemGroup>
    <!-- These sources are compiled inside the shader assembly, copied there by build_xlate.py. -->
    <Compile Remove="compat/**/*.cs" />
    <ProjectReference Include="$(RyuSrc)/src/Ryujinx.Graphics.Shader/Ryujinx.Graphics.Shader.csproj" />
    <ProjectReference Include="$(RyuSrc)/src/Ryujinx.Common/Ryujinx.Common.csproj" />
  </ItemGroup>
</Project>
